# Modèle de configuration locale. Copiez-le en .env et adaptez-le :
#     cp .env.example .env
# Le fichier .env n'est jamais commité : c'est là que vont les secrets.

# Base de données (les valeurs par défaut suffisent pour développer)
DB_NAME=eau
DB_USER=eau
DB_PASSWORD=eau

# Ports ouverts sur votre machine. Changez-les s'ils sont déjà pris.
PORT_WEB=8080
PORT_BASE=5432

# Sous Linux avec Docker classique, les fichiers créés depuis le conteneur
# (vendor/, caches) appartiennent à root. Pour qu'ils vous appartiennent,
# décommentez la ligne et mettez le résultat de : echo "$(id -u):$(id -g)"
# Inutile avec Docker Desktop (Windows, macOS) et avec Docker rootless.
# UID_GID=1000:1000
