# Réglages lus par VS Code, PhpStorm et la plupart des éditeurs : https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Les fichiers de test ne doivent pas être « corrigés » par l'éditeur
[tests/fichiers/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
